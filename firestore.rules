rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Orders Collection: Real-time orders for customers, kitchen and POS
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) 
                    && request.resource.data.tableNumber is number;
      allow update: if isValidId(orderId);
      allow delete: if true;
    }

    // Waiter Calls Collection: Assistance calls and bill requests from tables
    match /waiterCalls/{callId} {
      allow read: if true;
      allow create: if isValidId(callId) 
                    && request.resource.data.tableNumber is number;
      allow update: if isValidId(callId);
      allow delete: if true;
    }

    // Inventory Collection: Real-time stock counts and 86 availability
    match /inventory/{itemId} {
      allow read: if true;
      allow write: if isValidId(itemId);
    }

    // Restaurant Settings Collection: Restaurant metadata and billing
    match /restaurantSettings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
